# ByteStash environment configuration

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=$HOSTNAME
BASE_DOMAIN_NAME=example.com

# Application secret (JWT signing key — change this!)
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Allow new user registration (true/false)
BYTESTASH_ALLOW_REGISTRATION=true

# JWT token expiry in hours
BYTESTASH_TOKEN_EXPIRY_HOURS=24

# Disable user accounts entirely (single-user mode)
BYTESTASH_DISABLE_ACCOUNTS=false
